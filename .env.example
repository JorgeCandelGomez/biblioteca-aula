# Copia este fichero como .env y ajusta los valores (los de aquí son ficticios)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/biblioteca
SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta
# Solo en PRODUCCIÓN (~/despliegue-biblioteca en la EC2):
# imagen publicada en GHCR, en minúsculas, y versión sin la v (v1.2.0 -> 1.2.0).
# Nunca "latest": no sabrías qué versión corre ni a cuál volver.
IMAGEN=ghcr.io/JorgeCandelGomez/biblioteca
VERSION=1.2.0